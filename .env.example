# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Environment: "local" or "production" — controls WP_DEBUG, error display,
# forced SSL admin, etc. (see wp-config.php)
WP_ENV=local

# --- Site -----------------------------------------------------------------
WP_TITLE="WagerWise"
WP_HOME=http://localhost:8095
WP_SITEURL=http://localhost:8095
WP_TABLE_PREFIX=ww_

# --- Bootstrap admin user (created once by wp-cli/bootstrap.sh) -----------
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-now-please
WP_ADMIN_EMAIL=you@example.com

# --- Database ---------------------------------------------------------------
DB_HOST=db
DB_NAME=wagerwise
DB_USER=wagerwise
DB_PASSWORD=change-me-too
DB_ROOT_PASSWORD=change-me-root

# --- Auth salts -------------------------------------------------------------
# Generate fresh values for real deployments:
#   curl https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=put-your-unique-phrase-here
SECURE_AUTH_KEY=put-your-unique-phrase-here
LOGGED_IN_KEY=put-your-unique-phrase-here
NONCE_KEY=put-your-unique-phrase-here
AUTH_SALT=put-your-unique-phrase-here
SECURE_AUTH_SALT=put-your-unique-phrase-here
LOGGED_IN_SALT=put-your-unique-phrase-here
NONCE_SALT=put-your-unique-phrase-here

# --- Production only ---------------------------------------------------------
# Domain nginx/certbot will issue a TLS cert for. DNS must already point here.
DOMAIN=casinoradar.io
CERTBOT_EMAIL=you@example.com
REDIS_HOST=redis
