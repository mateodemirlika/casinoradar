# Processed by the official nginx image's envsubst entrypoint hook
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf), substituting
# ${DOMAIN} from the container environment.
#
# Plain HTTP only: the shared Traefik reverse proxy (external "proxy" Docker
# network) terminates TLS and handles the Let's Encrypt certificate for
# ${DOMAIN}, then forwards decrypted traffic here over the Docker network.
# This container is never reached directly from the internet.

server {
    listen 80;
    server_name ${DOMAIN};

    root /var/www/html;
    index index.php;

    client_max_body_size 64M;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        fastcgi_pass wordpress:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    location ~* /wp-content/uploads/.*\.php$ {
        deny all;
    }

    # /robots.txt has no location block on purpose — it isn't a physical
    # file, so it must fall through to the location / block above and reach
    # index.php. WordPress serves it dynamically (do_robots), and Rank Math
    # hooks into that output to add its "Sitemap: ..." directive. A location
    # block here with no try_files/fastcgi_pass would just 404 it directly.
    #
    # /favicon.ico DOES get a real static file here (a favicon checker wants
    # an actual reachable file at the root, not WordPress's redirect-based
    # virtual fallback) — served straight off disk from the theme, bypassing
    # PHP entirely.
    location = /favicon.ico {
        alias /var/www/html/wp-content/themes/wagerwise/assets/images/favicon.ico;
        access_log off;
        log_not_found off;
    }

    # nginx's bundled mime.types doesn't know .webmanifest, so it'd otherwise
    # serve it as application/octet-stream.
    location ~* \.webmanifest$ {
        default_type application/manifest+json;
        expires 30d;
        access_log off;
    }
}
